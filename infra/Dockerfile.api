FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/packages:/app/apps/api \
    ALINEA_STORAGE_ROOT=/data/storage \
    ALINEA_SOFFICE_PATH=/usr/bin/soffice \
    ALINEA_RENDER_TIMEOUT_SECONDS=120 \
    HOME=/tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends libreoffice-writer fonts-noto-cjk fontconfig \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system alinea \
    && useradd --system --gid alinea --home-dir /tmp alinea

WORKDIR /app
COPY pyproject.toml ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY examples ./examples
RUN pip install --no-cache-dir . \
    && mkdir -p /data/storage \
    && chown -R alinea:alinea /data /app

USER alinea
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')" || exit 1
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
